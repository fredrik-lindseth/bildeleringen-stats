{
  "manifest_version": 3,
  "name": "Bildeleringen Fleksibel",
  "version": "0.2.0",
  "description": "Fleksibelt booking-søk for dele.no: finn når en bil faktisk er ledig",
  "permissions": ["storage", "scripting", "alarms", "notifications"],
  "host_permissions": ["*://app.dele.no/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://app.dele.no/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "watches.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "bildeleringen-flex@extension",
      "strict_min_version": "128.0"
    }
  }
}
